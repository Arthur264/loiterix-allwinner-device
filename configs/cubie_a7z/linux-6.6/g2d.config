# Enable Allwinner G2D for Cubie A7Z (sun60iw2 / A733).
# Also set in configs/default/linux-6.6/bsp_defconfig (KBUILD_DEFCONFIG=bsp.config).
# Creates /dev/g2d via bsp/drivers/g2d (RCQ). Device tree node g2d@5440000
# is already present in sun60iw2p1.dtsi; board.dts sets status = "okay".
# udev: /etc/udev/rules.d/99-g2d.rules already has KERNEL=="g2d", MODE="0666".
CONFIG_AW_G2D=y
CONFIG_G2D_RCQ=y
